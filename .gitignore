# Public release allowlist. Local history/review/backup files stay in place.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/.npmrc
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/playwright.config.ts
!/src/
!/tests/
!/scripts/
!/art/
!/docs/
!/.github/

/scripts/*
!/scripts/asset-contract.py
!/scripts/asset-manifest.json
!/scripts/verify-assets.py
!/scripts/verify-character-style.py
!/scripts/test-asset-validation.py
!/scripts/build-nora-reveal.py
!/scripts/generate-assets.py
!/scripts/verify-static.mjs

/art/*
!/art/character-style-reference/
!/art/morrow-selfie/
!/art/curated/

/docs/*
!/docs/licenses/
!/docs/asset-sources.md

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

node_modules/
dist/
.cache/
test-results/
playwright-report/
__pycache__/
*.py[cod]
*.tsbuildinfo
*.log
.DS_Store
.env
.env.*
*.pem
*.key
